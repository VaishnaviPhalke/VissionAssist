# Git ignore for VisionAssist AI

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
/lib/
lib64/
!vision_assist_app/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
venv/
ENV/

# Large APK and temporary outputs (keep repo clean and within GitHub 100MB limit)
*.apk
*.aab
!VisionAssist_AI.apk

# Flutter & Dart
vision_assist_app/.dart_tool/
vision_assist_app/.flutter-plugins
vision_assist_app/.flutter-plugins-dependencies
vision_assist_app/.pub-cache/
vision_assist_app/.pub/
vision_assist_app/build/
**/ios/Flutter/.last_build_id

# Android / Gradle
vision_assist_app/android/.gradle/
vision_assist_app/android/local.properties
vision_assist_app/android/app/build/
*.class
*.log

# IDE & OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.cache
